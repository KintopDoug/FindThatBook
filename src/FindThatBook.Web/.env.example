# Copy to .env.local to override. Every value here is optional.

# Absolute base URL of the API. Leave unset in development: requests then go to the Vite
# dev server, which proxies /api to VITE_API_PROXY_TARGET and keeps the browser same-origin.
# VITE_API_BASE_URL=https://your-deployed-api.example.com

# Where the dev proxy forwards /api. Defaults to the API's HTTPS launch profile.
# VITE_API_PROXY_TARGET=https://localhost:7082

# Client-side request ceiling in milliseconds. Defaults to 60000, which allows for an LLM
# call plus several rate-paced Open Library requests.
# VITE_API_TIMEOUT_MS=60000
