<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Feeds XML doc comments into the generated OpenAPI document / Swagger UI. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Enables `dotnet user-secrets` so the Gemini API key never lands in appsettings.json. -->
    <UserSecretsId>f578991a-e29d-4727-be85-f90554fec06c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FindThatBook.ServiceDefaults\FindThatBook.ServiceDefaults.csproj" />
  </ItemGroup>


</Project>
